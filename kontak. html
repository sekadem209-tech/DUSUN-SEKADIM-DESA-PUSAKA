            <li>
                <a href="kontak.html" class="active">
                    Kontak
                </a>
            </li>

        </ul>

    </nav>

</header>


<section class="page-hero">

    <div>

        <p>
            HUBUNGI KAMI
        </p>

        <h1>
            Kontak Desa
        </h1>

        <span>
            Informasi dan pesan untuk Desa Pusaka
        </span>

    </div>

</section>


<section class="section">

    <div class="contact-grid">


        <!-- INFORMASI -->

        <div class="contact-info">

            <span class="small-title">
                INFORMASI
            </span>

            <h2>
                Hubungi Kami
            </h2>

            <p>
                Untuk informasi lebih lanjut mengenai Desa Pusaka
                dan Dusun Sekadim, silakan gunakan informasi
                kontak berikut.
            </p>


            <div class="contact-item">

                <div class="contact-icon">
                    📍
                </div>

                <div>

                    <h3>
                        Alamat
                    </h3>

                    <p>
                        Dusun Sekadim, Desa Pusaka,
                        Kabupaten Sambas,
                        Kalimantan Barat.
                    </p>

                </div>

            </div>


            <div class="contact-item">

                <div class="contact-icon">
                    📞
                </div>

                <div>

                    <h3>
                        Telepon
                    </h3>

                    <p>
                        Nomor telepon desa dapat ditambahkan
                        di sini.
                    </p>

                </div>

            </div>


            <div class="contact-item">

                <div class="contact-icon">
                    ✉️
                </div>

                <div>

                    <h3>
                        Email
                    </h3>

                    <p>
                        Email desa dapat ditambahkan
                        di sini.
                    </p>

                </div>

            </div>

        </div>


        <!-- FORM -->

        <div class="contact-form">

            <h2>
                Kirim Pesan
            </h2>

            <p>
                Silakan isi formulir berikut.
            </p>


            <form id="contactForm">

                <label>
                    Nama
                </label>

                <input
                    type="text"
                    id="nama"
                    placeholder="Masukkan nama"
                    required
                >


                <label>
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    placeholder="Masukkan email"
                    required
                >


                <label>
                    Pesan
                </label>

                <textarea
                    id="pesan"
                    rows="6"
                    placeholder="Tulis pesan..."
                    required
                ></textarea>


                <button
                    type="submit"
                    class="btn btn-primary full"
                >
                    Kirim Pesan
                </button>

            </form>

        </div>

    </div>

</section>


<!-- MAP PLACEHOLDER -->

<section class="map-section">

    <div>

        <div class="map-icon">
            📍
        </div>

        <h2>
            Dusun Sekadim
        </h2>

        <p>
            Desa Pusaka, Kabupaten Sambas,
            Kalimantan Barat
        </p>

    </div>

</section>


<footer class="footer">

    <div class="footer-content">

        <div>

            <h3>
                🌿 Desa Pusaka
            </h3>

            <p>
